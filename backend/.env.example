# Mbamager backend — environment variables
# Copy this file to `.env` and fill in real values for local development.
# All fields below mirror backend/app/core/config.py:Settings

PROJECT_NAME=Mbamager
VERSION=0.1.0
DEBUG=True

# --- Cryptographic JWT config ---
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-for-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Comma-separated list of allowed frontend origins. No wildcard: the API is
# read from an Authorization header, not cookies, so credentialed CORS is
# never required, but explicit origins are still the safer default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL database (async driver — repositories use AsyncSession) ---
# Local dev matches docker-compose.yml (see repo root); update user/password/db
# name/host/port for staging or production.
DATABASE_URL=postgresql+asyncpg://mbamager:mbamager@localhost:5432/mbamager

# --- SMTP config for password recovery emails ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mbamager.com

# --- Gemini API (Cognitive/AI layer) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=1000
